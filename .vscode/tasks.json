{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "P0: frontend build",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "P0: backend dev",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"--project",
				"backend",
				"uvicorn",
				"app.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "P0: frontend dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}